{
  "name": "specproof-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Open-core diff-scoped test integrity, micro-mutation, and spec-to-PR verification gate for AI-assisted engineering teams.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
