{
  "name": "@specproof/cli",
  "version": "0.2.0",
  "description": "CLI, MCP launcher, and GitHub Action verification gate for SpecProof.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Claw2M/specproof-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claw2M/specproof-.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Claw2M/specproof-/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specproof": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["specproof", "cli", "github-actions", "ci-cd", "mutation-testing", "mcp"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@specproof/core": "0.2.0",
    "@specproof/mcp-server": "0.2.0",
    "@specproof/mutator": "0.2.0"
  }
}
