{
  "name": "@specproof/core",
  "version": "0.2.0",
  "description": "Git diff parser, TS/JS/Python/Go AST test integrity analyzer, spec mapper, GitHub Check Runs, and report formatters for SpecProof.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Claw2M/specproof-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claw2M/specproof-.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Claw2M/specproof-/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["specproof", "testing", "mutation-testing", "ai-code-review", "devtools"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "^5.8.0"
  }
}
