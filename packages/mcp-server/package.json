{
  "name": "@specproof/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) verification server for Cursor, Claude Code, Windsurf, and coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specproof-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["specproof", "mcp", "model-context-protocol", "cursor", "claude-code"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@specproof/core": "0.1.0",
    "@specproof/mutator": "0.1.0",
    "zod": "^4.0.0"
  }
}
