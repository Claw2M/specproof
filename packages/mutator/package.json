{
  "name": "@specproof/mutator",
  "version": "0.1.0",
  "description": "Diff-scoped TypeScript/JavaScript micro-mutation generator and isolated runner for SpecProof.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["specproof", "mutation-testing", "ast", "devtools"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@specproof/core": "0.1.0",
    "typescript": "^5.8.0"
  }
}
