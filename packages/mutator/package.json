{
  "name": "@specproof/mutator",
  "version": "0.2.0",
  "description": "Diff-scoped TypeScript/JavaScript, Python, and Go micro-mutation generator and isolated parallel runner for SpecProof.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Claw2M/specproof-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claw2M/specproof-.git",
    "directory": "packages/mutator"
  },
  "bugs": {
    "url": "https://github.com/Claw2M/specproof-/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["specproof", "mutation-testing", "ast", "devtools"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@specproof/core": "0.2.0",
    "typescript": "^5.8.0"
  }
}
