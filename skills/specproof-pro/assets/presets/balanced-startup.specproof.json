{
  "testCommand": "npm test",
  "maxMutantsPerRun": 25,
  "mutationTimeoutMs": 10000,
  "failUnderMutationScore": 70,
  "mockToAssertionMaxRatio": 2.5,
  "minMocksBeforeFlagging": 3,
  "blockOnMockAbuse": false,
  "blockOnVacuous": true,
  "requireSpecMatch": false,
  "specFile": "SPEC.md",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".specproof-tmp",
    ".specproof-cloud",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    "target",
    ".next"
  ]
}
